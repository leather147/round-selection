{
  "name": "round-selection-monorepo",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @round-selection/web dev",
    "dev:demo": "pnpm --filter @round-selection/demo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && node -e \"require('node:fs').rmSync('node_modules',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "turbo": "2.10.7",
    "typescript": "5.8.3"
  }
}
